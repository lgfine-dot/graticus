# Contact form → Resend. Copy to `.env` for local `netlify dev`, and set the
# same three in the Netlify UI for the deployed site. `.env` is gitignored;
# this repo is public, so the real key must never be committed.

# Create at https://resend.com/api-keys with "Sending access" permission only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where enquiries land. Defaults to hello@graticus.com.
# CONTACT_TO=

# Optional. Defaults to "Graticus <hello@graticus.com>".
# Must be on a domain verified at https://resend.com/domains.
# CONTACT_FROM=
