# Contact form → Resend. Copy to `.env` for local `netlify dev`, and set the
# same three in the Netlify UI for the deployed site. `.env` is gitignored;
# this repo is public, so the real key must never be committed.

# Create at https://resend.com/api-keys with "Sending access" permission only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where enquiries land. Defaults to lawrence@agcp.pt, a mailbox known
# to be read. Switch to hello@graticus.com once that one is confirmed working.
# CONTACT_TO=

# Optional. Must be on a domain verified at https://resend.com/domains.
# Leave unset and the function uses Graticus Site <graticus@agcptech.com>, the
# only verified domain on the account. Set this to
# "Graticus <hello@graticus.com>" the day graticus.com verifies.
# CONTACT_FROM=
